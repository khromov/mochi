{
  "name": "mochi-site",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun src/lib/generateDocsBarrel.ts && bun src/lib/generateBlogBarrel.ts && mochi-framework build",
    "start": "bun src/index.ts",
    "dev": "MODE=development bun src/index.ts",
    "typecheck": "bun src/lib/generateDocsBarrel.ts && bun src/lib/generateBlogBarrel.ts && svelte-check --tsconfig ./tsconfig.json --compiler-warnings 'attribute_illegal_colon:ignore' && tsc -p tsconfig.json --noEmit",
    "test": "bun scripts/run-tests.ts",
    "clean": "rimraf .mochi"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/lobster-two": "^5.2.8",
    "@fontsource/public-sans": "^5.2.7",
    "@lucide/svelte": "^1.24.0",
    "@tmcp/adapter-valibot": "0.1.6",
    "@tmcp/transport-http": "0.8.6",
    "mdsvex": "^0.12.7",
    "mochi-framework": "workspace:*",
    "mochi-shared": "workspace:*",
    "rehype-slug": "^6.0.0",
    "shiki": "^4.3.1",
    "slugify": "^1.6.9",
    "svelte": "^5.56.5",
    "svelte-french-toast": "2.0.0-alpha.0",
    "svelte-meta-tags": "^5.0.0",
    "svelte-youtube-lite": "^1.3.0",
    "tmcp": "1.19.4",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "svelte-check": "4.7.3",
    "typescript": "^6.0.3"
  }
}
