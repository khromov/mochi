{
  "name": "mochi-site",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "build": "bun src/lib/generateDocsBarrel.ts && mochi-framework build",
    "start": "bun src/index.ts",
    "dev": "MODE=development bun --hot src/index.ts",
    "typecheck": "bun src/lib/generateDocsBarrel.ts && svelte-check --tsconfig ./tsconfig.json --compiler-warnings 'attribute_illegal_colon:ignore' && tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rimraf .mochi"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/lobster-two": "^5.2.8",
    "@fontsource/public-sans": "^5.2.7",
    "@lucide/svelte": "^1.16.0",
    "mdsvex": "^0.12.7",
    "mochi-framework": "workspace:*",
    "rehype-slug": "^6.0.0",
    "shiki": "4.1.0",
    "slugify": "^1.6.9",
    "svelte": "^5.55.9",
    "svelte-french-toast": "2.0.0-alpha.0",
    "svelte-meta-tags": "^4.7.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/js-cookie": "^3.0.6",
    "svelte-check": "4.4.7",
    "typescript": "^6.0.3"
  }
}
