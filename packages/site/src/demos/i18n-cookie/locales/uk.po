#: src/demos/i18n-cookie/I18nForm.svelte
msgid "Good day, and welcome to Mochi!"
msgstr "Доброго дня та ласкаво просимо до Mochi!"

#: src/demos/i18n-cookie/I18nForm.svelte
msgid "This panel re-translates itself instantly when you switch languages — no page reload."
msgstr "Ця панель миттєво перекладається, коли ви змінюєте мову — без перезавантаження сторінки."

#: src/demos/i18n-cookie/I18nForm.svelte
msgid "Your choice is stored in a cookie, so the server renders this page in your language next time you visit."
msgstr "Ваш вибір зберігається в cookie, тож наступного разу сервер відрендерить цю сторінку вашою мовою."

#: src/demos/i18n-cookie/I18nForm.svelte
msgid "Choose your language"
msgstr "Виберіть свою мову"

#: src/demos/i18n-cookie/I18nForm.svelte
msgid "Language"
msgstr "Мова"

#: src/demos/i18n-cookie/I18nForm.svelte
msgid "Active language code: <0/>"
msgstr "Активний код мови: <0/>"

#: src/demos/i18n-cookie/I18nCookie.svelte
msgid "Internationalization (cookies)"
msgstr "Internationalization (cookies)"

#: src/demos/i18n-cookie/I18nCookie.svelte
msgid "A cookie holds the visitor's language. Mochi reads it during SSR so the page renders translated, and the hydrated island switches language in place — then writes the cookie so the choice sticks on the next request."
msgstr "A cookie holds the visitor's language. Mochi reads it during SSR so the page renders translated, and the hydrated island switches language in place — then writes the cookie so the choice sticks on the next request."
