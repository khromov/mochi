# packages/support — copy to .env and fill in. Bun auto-loads .env from the
# package cwd. Production values come from the CapRover app's env, not from a
# file: the root .dockerignore strips .env* out of the build context.

# --- Required in production -------------------------------------------------
# The server refuses to boot without these (see the mochi:init hook in
# src/index.ts). Leave them unset in development and Mochi captures mail into
# the in-memory outbox at http://localhost:3336/_mochi/email instead of sending.

# Absence of SMTP_HOST is the switch that disables the SMTP transport entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Public origin. Mochi's CSRF check rejects every form POST in production unless
# proxy.origin is set, so without this the form 403s on submit.
MOCHI_ORIGIN=https://support.mochi.fast

# Basic-auth credentials for /admin/, where submissions are triaged. An unset
# ADMIN_PASSWORD locks the panel to everyone, so the server refuses to boot
# without it in production.
ADMIN_USER=admin
ADMIN_PASSWORD=mochi

# --- Optional ---------------------------------------------------------------
# How long a rejected /admin/ attempt is held before answering, in ms. The delay
# only applies to wrong or missing credentials; a valid login is never slowed.
# ADMIN_AUTH_DELAY_MS=5000
# Where submissions AND newsletter subscribers are stored. Relative to the package
# root; the directory is created on boot. Not persisted across container restarts
# unless mounted — losing the subscriber list this way is unrecoverable, so mount
# a volume before relying on the newsletter.
# SUPPORT_DB=.db/support.sqlite
# Implicit TLS on connect. Defaults to `port === 465`.
# SMTP_SECURE=false
# Sender address. Must be one the relay is authorized to send as; defaults to
# SMTP_USER, since relays typically only accept the authenticated mailbox.
# SMTP_FROM=Mochi Support Form <support@mochi.fast>
# Where support requests land.
# SUPPORT_TO=support@mochi.fast
# --- Newsletter widget ------------------------------------------------------
# The signup widget at /newsletter/embed/ is iframed by the blog on mochi.fast.
# Space-separated CSP frame-ancestors allow-list — who may embed it. Defaults to
# the mochi.fast origins (plus localhost in development).
# NEWSLETTER_EMBED_ANCESTORS=https://mochi.fast https://www.mochi.fast
# Sender for the double opt-in confirmation email. Defaults to SMTP_FROM.
# NEWSLETTER_FROM=Mochi <newsletter@mochi.fast>
# How long a confirmation link stays valid.
# NEWSLETTER_CONFIRM_TTL_DAYS=14
# Minimum gap between confirmation emails to the same unconfirmed address, in ms.
# NEWSLETTER_RESEND_COOLDOWN_MS=300000

# Silences a boot warning; only load-bearing if this site ever grows a
# mochi:defer island or signed image URLs.
# MOCHI_KEY=
# PORT=3336
