{
  "name": "mochi-support",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "mochi-framework build",
    "start": "bun src/index.ts",
    "dev": "MODE=development bun src/index.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings 'attribute_illegal_colon:ignore' && tsc -p tsconfig.json --noEmit",
    "test": "bun scripts/run-tests.ts",
    "clean": "rimraf .mochi"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource/public-sans": "^5.2.7",
    "mochi-framework": "workspace:*",
    "mochi-shared": "workspace:*",
    "svelte": "^5.56.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "svelte-check": "4.7.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "msgpackr-extract": "npm:@mochi-framework/msgpackr-extract-stub@*"
  }
}
