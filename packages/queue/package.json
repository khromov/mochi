{
  "name": "@mochi-framework/queue",
  "version": "0.0.1",
  "description": "Minimal SQL-backed job queue for Bun — in-memory, SQLite, or Postgres via Bun.SQL.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mochi",
    "queue",
    "jobs",
    "bun",
    "sqlite",
    "postgres"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khromov/mochi.git",
    "directory": "packages/queue"
  },
  "homepage": "https://github.com/khromov/mochi/tree/main/packages/queue#readme",
  "bugs": {
    "url": "https://github.com/khromov/mochi/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/__fixtures__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-socket": "0.2.7",
    "@types/bun": "1.3.14",
    "typescript": "^6.0.3"
  }
}
