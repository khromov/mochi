    "remotion": "4.0.478"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
