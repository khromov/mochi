{
  "name": "mochi-demos",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bun scripts/prebuild.ts && mochi-framework build",
    "start": "bun src/index.ts",
    "dev": "NODE_ENV=development bun src/index.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings 'attribute_illegal_colon:ignore' && tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf .mochi"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@lucide/svelte": "^1.28.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "html-entities": "^2.6.0",
    "mochi-framework": "workspace:*",
    "svelte": "^5.56.8",
    "svelte-meta-tags": "^5.0.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "svelte-check": "4.7.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "msgpackr-extract": "npm:@mochi-framework/msgpackr-extract-stub@*"
  }
}
