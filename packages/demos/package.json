{
  "name": "mochi-demos",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "build": "bun scripts/prebuild.ts && mochi-framework build",
    "start": "bun src/index.ts",
    "dev": "MODE=development bun src/index.ts",
    "extract": "wuchale",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings 'attribute_illegal_colon:ignore' && tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rimraf .mochi"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@lucide/svelte": "^1.18.0",
    "@tailwindcss/node": "^4.3.1",
    "@tailwindcss/oxide": "^4.3.1",
    "@wuchale/svelte": "^0.20.0",
    "html-entities": "^2.6.0",
    "mochi-framework": "workspace:*",
    "svelte": "^5.56.3",
    "svelte-meta-tags": "^5.0.0",
    "tailwindcss": "^4.3.1",
    "wuchale": "^0.24.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "svelte-check": "4.6.0",
    "typescript": "^6.0.3"
  }
}
