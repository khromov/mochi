# Copy to .env and fill in — the Mailer demo (/mailer/) sends via Mailgun's SMTP.
# Without these, email falls back to the dev transport (captured at /_mochi/email).
SMTP_USER=
SMTP_PASSWORD=
# Include a display name with the `Name <addr>` form (no quotes needed):
SMTP_FROM=Mochi <mochi@mailer.orb.yt>
# SMTP_HOST=smtp.eu.mailgun.org
# SMTP_PORT=465
