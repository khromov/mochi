{
  "name": "mochi-framework",
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "svelte",
    "bun",
    "ssr",
    "framework",
    "islands",
    "hydration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khromov/mochi.git",
    "directory": "packages/mochi"
  },
  "homepage": "https://github.com/khromov/mochi/tree/main/packages/mochi#readme",
  "bugs": {
    "url": "https://github.com/khromov/mochi/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "bin": {
    "mochi-framework": "src/cli.js"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/__fixtures__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./build": {
      "types": "./src/build.ts",
      "bun": "./src/build.ts",
      "default": "./src/build.ts"
    },
    "./highlight": {
      "types": "./src/highlight.ts",
      "bun": "./src/highlight.ts",
      "default": "./src/highlight.ts"
    },
    "./tailwind": {
      "types": "./src/tailwind.ts",
      "bun": "./src/tailwind.ts",
      "default": "./src/tailwind.ts"
    },
    "./ambient": {
      "types": "./src/mochi-ambient.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun scripts/run-tests.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings 'attribute_illegal_colon:ignore' && tsc -p tsconfig.json --noEmit",
    "deps:report": "bun scripts/dep-report.ts"
  },
  "peerDependencies": {
    "svelte": "^5.55.7",
    "@tailwindcss/node": "^4.0.0",
    "@tailwindcss/oxide": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/node": {
      "optional": true
    },
    "@tailwindcss/oxide": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/negotiator": "^0.6.4",
    "chokidar": "^4.0.3",
    "deepmerge": "^4.3.1",
    "devalue": "^5.8.1",
    "js-cookie": "^3.0.7",
    "magic-string": "^0.30.21",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.11",
    "negotiator": "^1.0.0",
    "stale-while-revalidate-cache": "^3.4.1",
    "zimmerframe": "^1.1.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.9.0",
    "@tailwindcss/node": "4.3.0",
    "@tailwindcss/oxide": "4.3.0",
    "@types/bun": "1.3.14",
    "@types/js-cookie": "^3.0.6",
    "svelte": "^5.55.9",
    "svelte-check": "4.4.7",
    "typescript": "^6.0.3"
  }
}
