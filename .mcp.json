{
  "mcpServers": {
    "svelte": {
      "type": "http",
      "url": "https://mcp.svelte.dev/mcp"
    },
    "mochi": {
      "type": "http",
      "url": "https://mochi.fast/mcp"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "bunx",
