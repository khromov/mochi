# Prebuilt production image for any Mochi workspace (site, minimal, demos).
# Defaults to packages/site. Override with --build-arg WORKSPACE=<name>
# and --build-arg PORT=<port>. Runs `bun --cwd=packages/<workspace> run start`,
# so SSR + client bundles are baked at build time and no Svelte preprocessor
# / devDeps are present at runtime.
#
# Base image is oven/bun:1.3.14-alpine for all stages (pure musl alpine,
# bun preinstalled, plays nicely with native bindings end-to-end). The
# earlier frolvlad/alpine-glibc + copied-bun pattern caused the
# @tailwindcss/oxide loader to hit a glibc compat shim on arm64.
#
# tailwindcss / lightningcss are only required by packages/demos (todo app).
# For any other workspace they're stripped after install to keep the image
# slim (~24 MB of native prebuilts + tailwind itself).

ARG WORKSPACE=site
ARG PORT=3333
# Global scope (before the first FROM) so every stage's FROM can read it. Kept in
# sync with the root Dockerfile's arg of the same name; build.yml passes it to
# every matrix leg.
ARG BUN_IMAGE=oven/bun:1.3.14-alpine

FROM ${BUN_IMAGE} AS base
WORKDIR /usr/src/app

# install stage — copy only mochi + the target workspace, then write a
# narrowed root package.json so bun install resolves workspace:* across
# just the two we need. Lockfile is regenerated (the source lockfile
# references site/demos/etc. that aren't all present here).
FROM base AS install
ARG WORKSPACE
COPY packages/mochi /temp/prod/packages/mochi
COPY packages/docs /temp/prod/packages/docs
COPY packages/shared /temp/prod/packages/shared
COPY packages/${WORKSPACE} /temp/prod/packages/${WORKSPACE}
RUN printf '{\n  "name": "mochi-monorepo",\n  "private": true,\n  "type": "module",\n  "workspaces": ["packages/mochi", "packages/docs", "packages/shared", "packages/%s"]\n}\n' "${WORKSPACE}" > /temp/prod/package.json
RUN cd /temp/prod && bun install --production --omit=dev
# Tailwind/lightningcss are demos-only. Mochi-framework declares them as
# optional peers + transitive paths still pull them in; prune for everyone
# except demos.
RUN if [ "${WORKSPACE}" != "demos" ]; then \
        rm -rf /temp/prod/node_modules/.bun/@tailwindcss* \
               /temp/prod/node_modules/.bun/tailwindcss* \
               /temp/prod/node_modules/.bun/lightningcss* \
               /temp/prod/node_modules/@tailwindcss \
               /temp/prod/node_modules/tailwindcss \
               /temp/prod/node_modules/lightningcss* ; \
    fi

# build stage — prebuild SSR + client bundles for the target workspace.
FROM base AS build
ARG WORKSPACE
COPY --from=install /temp/prod/node_modules node_modules
COPY --from=install /temp/prod/packages/${WORKSPACE}/node_modules packages/${WORKSPACE}/node_modules
COPY --from=install /temp/prod/packages/mochi/node_modules packages/mochi/node_modules
COPY --from=install /temp/prod/packages/docs/node_modules packages/docs/node_modules
COPY --from=install /temp/prod/packages/shared/node_modules packages/shared/node_modules
COPY --from=install /temp/prod/package.json ./
COPY packages/mochi packages/mochi
COPY packages/docs packages/docs
COPY packages/shared packages/shared
COPY packages/${WORKSPACE} packages/${WORKSPACE}
RUN bun --cwd=packages/${WORKSPACE} run build

# release image — same alpine base, no glibc shim, bun already on PATH
FROM base AS release
ARG WORKSPACE
ARG PORT
ENV WORKSPACE=${WORKSPACE}
# Without this the app never sees PORT and falls back to whatever its entry
# hardcodes — which happens to match today, but only by coincidence.
ENV PORT=${PORT}
# Mirrors the dev-mode Dockerfile. Apps gate their analytics snippet on this so
# it loads on the real deployment but never in local dev.
ENV MOCHI_DOCKER=true

COPY --from=install /temp/prod/package.json ./
COPY packages/mochi packages/mochi
COPY packages/docs packages/docs
COPY packages/shared packages/shared
COPY packages/${WORKSPACE} packages/${WORKSPACE}

COPY --from=install /temp/prod/node_modules node_modules
COPY --from=install /temp/prod/packages/${WORKSPACE}/node_modules packages/${WORKSPACE}/node_modules
COPY --from=install /temp/prod/packages/mochi/node_modules packages/mochi/node_modules
COPY --from=install /temp/prod/packages/docs/node_modules packages/docs/node_modules
COPY --from=install /temp/prod/packages/shared/node_modules packages/shared/node_modules

# --chown bakes runtime-user ownership into the COPY layer; a separate
# `RUN chown -R` would rewrite every file and duplicate the whole .mochi layer.
COPY --chown=bun:bun --from=build /usr/src/app/packages/${WORKSPACE}/.mochi packages/${WORKSPACE}/.mochi

# ncdu for disk usage analysis
RUN apk add --no-cache ncdu

# The workspace tree above is COPYed as root, so an app that opens a SQLite file
# at runtime (packages/support writes .db/support.sqlite) could not create the
# directory as `bun`. Pre-creating it owned by the runtime user also means a
# named volume mounted here inherits bun:bun instead of root.
RUN mkdir -p packages/${WORKSPACE}/.db && chown bun:bun packages/${WORKSPACE}/.db

# Dedicated, mountable image-transform cache — pre-created + chowned so a mounted
# volume inherits bun:bun; an app reads MOCHI_IMAGE_CACHE_DIR for image.cacheDir.
ENV MOCHI_IMAGE_CACHE_DIR=/data/image-cache
RUN mkdir -p /data/image-cache && chown -R bun:bun /data

USER bun
EXPOSE ${PORT}/tcp

# No curl/wget in the alpine base; bun is on PATH, so probe with fetch. Reads
# PORT from the env above and hits the canonical /health/ (trailingSlash:'always'
# would otherwise 308 a bare /health) so the redirect hop never happens. Every
# workspace built from this file serves /health — site, demos, support, minimal.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD bun --eval "fetch('http://127.0.0.1:'+process.env.PORT+'/health/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT [ "sh", "-c", "exec bun --cwd=packages/$WORKSPACE run start" ]
