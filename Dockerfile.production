# Prebuilt production image for any Mochi workspace (site, minimal, demos).
# Defaults to packages/site. Override with --build-arg WORKSPACE=<name>
# and --build-arg PORT=<port>. Runs `bun --cwd=packages/<workspace> run start`,
# so SSR + client bundles are baked at build time and no Svelte preprocessor
# / devDeps are present at runtime.
#
# Base image is oven/bun:1.3.14-alpine for all stages (pure musl alpine,
# bun preinstalled, plays nicely with native bindings end-to-end). The
# earlier frolvlad/alpine-glibc + copied-bun pattern caused the
# @tailwindcss/oxide loader to hit a glibc compat shim on arm64.
#
# tailwindcss / lightningcss are only required by packages/demos (todo app).
# For any other workspace they're stripped after install to keep the image
# slim (~24 MB of native prebuilts + tailwind itself).

ARG WORKSPACE=site
ARG PORT=3333

FROM oven/bun:1.3.14-alpine AS base
WORKDIR /usr/src/app

# install stage — copy only mochi + the target workspace, then write a
# narrowed root package.json so bun install resolves workspace:* across
# just the two we need. Lockfile is regenerated (the source lockfile
# references site/demos/etc. that aren't all present here).
FROM base AS install
ARG WORKSPACE
COPY packages/mochi /temp/prod/packages/mochi
COPY packages/docs /temp/prod/packages/docs
COPY packages/${WORKSPACE} /temp/prod/packages/${WORKSPACE}
RUN printf '{\n  "name": "mochi-monorepo",\n  "private": true,\n  "type": "module",\n  "workspaces": ["packages/mochi", "packages/docs", "packages/%s"]\n}\n' "${WORKSPACE}" > /temp/prod/package.json
RUN cd /temp/prod && bun install --production --omit=dev
# Tailwind/lightningcss are demos-only. Mochi-framework declares them as
# optional peers + transitive paths still pull them in; prune for everyone
# except demos.
RUN if [ "${WORKSPACE}" != "demos" ]; then \
        rm -rf /temp/prod/node_modules/.bun/@tailwindcss* \
               /temp/prod/node_modules/.bun/tailwindcss* \
               /temp/prod/node_modules/.bun/lightningcss* \
               /temp/prod/node_modules/@tailwindcss \
               /temp/prod/node_modules/tailwindcss \
               /temp/prod/node_modules/lightningcss* ; \
    fi

# build stage — prebuild SSR + client bundles for the target workspace.
FROM base AS build
ARG WORKSPACE
COPY --from=install /temp/prod/node_modules node_modules
COPY --from=install /temp/prod/packages/${WORKSPACE}/node_modules packages/${WORKSPACE}/node_modules
COPY --from=install /temp/prod/packages/mochi/node_modules packages/mochi/node_modules
COPY --from=install /temp/prod/packages/docs/node_modules packages/docs/node_modules
COPY --from=install /temp/prod/package.json ./
COPY packages/mochi packages/mochi
COPY packages/docs packages/docs
COPY packages/${WORKSPACE} packages/${WORKSPACE}
RUN bun --cwd=packages/${WORKSPACE} run build

# release image — same alpine base, no glibc shim, bun already on PATH
FROM base AS release
ARG WORKSPACE
ARG PORT
ENV WORKSPACE=${WORKSPACE}

COPY --from=install /temp/prod/package.json ./
COPY packages/mochi packages/mochi
COPY packages/docs packages/docs
COPY packages/${WORKSPACE} packages/${WORKSPACE}

COPY --from=install /temp/prod/node_modules node_modules
COPY --from=install /temp/prod/packages/${WORKSPACE}/node_modules packages/${WORKSPACE}/node_modules
COPY --from=install /temp/prod/packages/mochi/node_modules packages/mochi/node_modules
COPY --from=install /temp/prod/packages/docs/node_modules packages/docs/node_modules

COPY --from=build /usr/src/app/packages/${WORKSPACE}/.mochi packages/${WORKSPACE}/.mochi

# ncdu for disk usage analysis
RUN apk add --no-cache ncdu

# ensure the prebuilt cache is owned by the runtime user
RUN chown -R bun:bun packages/${WORKSPACE}/.mochi

USER bun
EXPOSE ${PORT}/tcp
ENTRYPOINT [ "sh", "-c", "exec bun --cwd=packages/$WORKSPACE run start" ]
