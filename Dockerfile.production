# Prebuilt production image for packages/site (the `mochi` app). Runs
# `bun run start`, which means SSR + client bundles are baked at build
# time and no Svelte preprocessor / devDeps are present at runtime.
#
# Base image is oven/bun:1.3.14-alpine for all stages (pure musl alpine,
# bun preinstalled, plays nicely with native bindings end-to-end). The
# earlier frolvlad/alpine-glibc + copied-bun pattern caused the
# @tailwindcss/oxide loader to hit a glibc compat shim on arm64.

FROM oven/bun:1.3.14-alpine AS base
WORKDIR /usr/src/app

# install dependencies into a temp directory — copy the whole packages/
# tree so bun install can reconcile the lockfile topology AND resolve
# workspace:* bin shims (e.g. mochi-framework -> src/cli.js). packages/
# also carries packages/mochi/patches/ which the root package.json's
# patchedDependencies field references.
FROM base AS install
COPY package.json bun.lock /temp/prod/
COPY packages /temp/prod/packages
# --production drops devDeps. Don't omit peers — mochi-framework's peer
# (svelte) must resolve from packages/mochi/src/ at build time, and dropping
# peers causes Bun to skip hoisting it to a place mochi can find.
RUN cd /temp/prod && bun install --frozen-lockfile --production --omit=dev

# build stage — prebuild Svelte SSR + client bundles via the site workspace
FROM base AS build
COPY --from=install /temp/prod/node_modules node_modules
COPY --from=install /temp/prod/packages/site/node_modules packages/site/node_modules
COPY --from=install /temp/prod/packages/mochi/node_modules packages/mochi/node_modules
COPY package.json tsconfig.json tsconfig.base.json ./
COPY packages packages
RUN bun --cwd=packages/site run build

# release image — same alpine base, no glibc shim, bun already on PATH
FROM base AS release

# source — release doesn't need packages/site/public (already baked into packages/site/.mochi/public)
COPY package.json tsconfig.json tsconfig.base.json ./
COPY packages/mochi packages/mochi
COPY packages/site/package.json packages/site/tsconfig.json packages/site/global.d.ts packages/site/svelte.config.js packages/site/
COPY packages/site/src packages/site/src

# production deps + workspace symlinks
COPY --from=install /temp/prod/node_modules node_modules
COPY --from=install /temp/prod/packages/site/node_modules packages/site/node_modules
COPY --from=install /temp/prod/packages/mochi/node_modules packages/mochi/node_modules

# prebuilt manifest, SSR/client bundles, and copied public assets
COPY --from=build /usr/src/app/packages/site/.mochi packages/site/.mochi

# ncdu for disk usage analysis
RUN apk add --no-cache ncdu

# ensure the prebuilt cache is owned by the runtime user
RUN chown -R bun:bun packages/site/.mochi

USER bun
EXPOSE 3333/tcp
ENTRYPOINT [ "bun", "run", "start" ]
